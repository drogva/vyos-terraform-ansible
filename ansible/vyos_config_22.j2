{%- set tunnels = [
    {'id': '1', 'peer': 'AWS-T1', 'vti': 'vti0', 'remote': tunnel1_remote_ip, 'psk': tunnel1_psk},
    {'id': '2', 'peer': 'AWS-T2', 'vti': 'vti1', 'remote': tunnel2_remote_ip, 'psk': tunnel2_psk}
] -%}

# 1. IKE / ESP 암호화 그룹 설정
set vpn ipsec ike-group AWS-IKE lifetime '28800'
set vpn ipsec ike-group AWS-IKE proposal 1 dh-group '2'
set vpn ipsec ike-group AWS-IKE proposal 1 encryption 'aes128'
set vpn ipsec ike-group AWS-IKE proposal 1 hash 'sha1'
set vpn ipsec ike-group AWS-IKE dead-peer-detection action 'restart'
set vpn ipsec ike-group AWS-IKE dead-peer-detection interval '15'
set vpn ipsec ike-group AWS-IKE dead-peer-detection timeout '30'

set vpn ipsec esp-group AWS-ESP lifetime '3600'
set vpn ipsec esp-group AWS-ESP mode 'tunnel'
set vpn ipsec esp-group AWS-ESP pfs 'enable'
set vpn ipsec esp-group AWS-ESP proposal 1 encryption 'aes128'
set vpn ipsec esp-group AWS-ESP proposal 1 hash 'sha1'

{% for t in tunnels %}
set vpn ipsec authentication psk {{ t.peer }} id '{{ local_public_ip }}'
set vpn ipsec authentication psk {{ t.peer }} secret '{{ t.psk }}'
set vpn ipsec site-to-site peer {{ t.peer }} authentication mode 'pre-shared-secret'
set vpn ipsec site-to-site peer {{ t.peer }} authentication local-id '{{ local_public_ip }}'
set vpn ipsec site-to-site peer {{ t.peer }} remote-address '{{ t.remote }}'
set vpn ipsec site-to-site peer {{ t.peer }} local-address '{{ local_private_ip }}'
set vpn ipsec site-to-site peer {{ t.peer }} ike-group 'AWS-IKE'
set vpn ipsec site-to-site peer {{ t.peer }} vti bind '{{ t.vti }}'
set vpn ipsec site-to-site peer {{ t.peer }} vti esp-group 'AWS-ESP'
{% endfor %}
